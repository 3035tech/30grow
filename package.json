{
  "name": "30grow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-sandbox.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "db:migrate": "node scripts/migrate.js",
    "db:validate-schema": "node scripts/validate-release-schema.js",
    "db:validate-schema:static": "node scripts/validate-release-schema.js --static",
    "ops:pilot-preflight": "node scripts/validate-pilot-integrations.js",
    "ops:render-s3-policy": "node scripts/render-s3-iam-policy.mjs",
    "ops:audit-admin-auth": "node scripts/audit-admin-api-auth.mjs",
    "release:pilot-check": "node scripts/validate-pilot-readiness.js",
    "release:post-deploy-smoke": "node scripts/validate-pilot-deployment.js",
    "db:test-motivators": "node test/unit/motivators-invite-flow.js",
    "test:ae-scoring": "node test/unit/ae-scoring.js",
    "i18n:translate": "node --env-file=.env scripts/i18n-translate-catalog.mjs",
    "db:seed": "node scripts/seed-data.js",
    "db:seed-demo-30pay": "node --env-file=.env scripts/seed-demo-30pay.js",
    "db:seed-demo-30pay:confirm": "CONFIRM_DEMO_PURGE=1 node --env-file=.env scripts/seed-demo-30pay.js",
    "db:seed-demo-todos-os-dados": "node --env-file=.env scripts/seed-demo-todos-os-dados.js",
    "db:seed-demo-todos-os-dados:confirm": "CONFIRM_DEMO_PURGE=1 node --env-file=.env scripts/seed-demo-todos-os-dados.js",
    "db:seed-demo-client-jobs-board": "node --env-file=.env scripts/seed-demo-client-jobs-board.js",
    "db:seed-demo-client-jobs-board:confirm": "CONFIRM_DEMO_PURGE=1 node --env-file=.env scripts/seed-demo-client-jobs-board.js",
    "db:seed-motivators": "node scripts/seed-motivators-questions.js",
    "db:seed-motivators-templates": "node scripts/seed-motivators-templates.js",
    "db:seed-motivators-all": "node scripts/seed-motivators-questions.js && node scripts/seed-motivators-templates.js",
    "db:create-super-admin": "node --env-file=.env scripts/create-super-admin.js",
    "db:clear": "node scripts/clear-data.js",
    "dtov:reset": "node test/dtov/harness.js reset",
    "dtov:up": "node test/dtov/harness.js up",
    "dtov:down": "node test/dtov/harness.js down",
    "dtov:migrate": "node test/dtov/harness.js migrate",
    "dtov:seed": "node test/dtov/harness.js seed",
    "dtov:smoke": "node test/dtov/harness.js smoke",
    "dtov:explain": "DTOV=1 node scripts/explain-hotpaths.js",
    "dtov:status": "node test/dtov/harness.js status",
    "dtov:full": "node test/dtov/harness.js reset && DTOV=1 node test/dtov/full-regression.js",
    "dtov:full-app": "node test/dtov/run-full-app.js",
    "test:full": "node test/dtov/full-regression.js",
    "test:full:offline": "node test/dtov/full-regression.js --offline",
    "test:unit": "node --experimental-vm-modules --test test/unit/*.unit.test.js",
    "test:security": "node --experimental-vm-modules --test test/unit/module-hardening.unit.test.js test/unit/dp-file-security.unit.test.js test/unit/employee-session-security.unit.test.js test/unit/storage-cache-security.unit.test.js test/unit/s3-managed-identity.unit.test.js test/unit/private-attachment-response.unit.test.js test/unit/session-slide.test.js test/unit/auth-security-regressions.unit.test.js test/unit/security-perimeter.unit.test.js test/unit/redis-connection.unit.test.js test/unit/tenant-scope.unit.test.js test/unit/session-schema-security.unit.test.js",
    "test:full:dtov": "DTOV=1 node test/dtov/full-regression.js",
    "test:http": "node test/dtov/http-smoke.js",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "stripe:configure": "node --env-file=.env scripts/configure-stripe.mjs",
    "test:billing": "node --experimental-vm-modules --test test/unit/stripe-billing.unit.test.js test/unit/company-license.unit.test.js test/unit/pricing-currency.unit.test.js",
    "test:release": "node scripts/validate-release-contracts.mjs",
    "test:stripe:sandbox": "node scripts/test-stripe-sandbox.mjs",
    "lint": "eslint app lib scripts test",
    "lint:inventory": "eslint app lib scripts test --format json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/client-secrets-manager": "3.1156.0",
    "@sentry/nextjs": "10.75.2",
    "@signpdf/placeholder-pdf-lib": "^4.0.0",
    "@signpdf/signpdf": "^4.0.0",
    "@signpdf/utils": "^4.0.0",
    "bcryptjs": "^3.0.3",
    "fflate": "^0.8.3",
    "ioredis": "^6.0.0",
    "jose": "6.2.13",
    "jsonwebtoken": "^9.0.2",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "signature_pad": "^5.1.4",
    "stripe": "23.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "autoprefixer": "^10.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    },
    "postcss-selector-parser": "7.1.6"
  },
  "engines": {
    "node": ">=22.23.4 <23"
  }
}

# ── Banco de dados ──────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=enneagram
POSTGRES_USER=enneagram_user
POSTGRES_PASSWORD=troque_esta_senha

# RDS/AWS: TLS é aplicado automaticamente se POSTGRES_HOST contiver .rds.amazonaws.com
# Forçar: POSTGRES_SSL=true | desligar: POSTGRES_SSL=false
# POSTGRES_SSL=true
# Verificação estrita do certificado CA (default omitido/false — comum em RDS interno/K8s):
# POSTGRES_SSL_REJECT_UNAUTHORIZED=false

# Máximo de conexões por instância (node-postgres Pool). Orçamento:
# max_connections no Postgres ≥ réplicas_app × PG_POOL_MAX × (1 se só primário, 2 se POSTGRES_READ_HOST definido).
# Ex.: 5 réplicas × 20 × 2 = 200 → reserve margem para admin/migrate.
PG_POOL_MAX=10
# Alias legado de PG_POOL_MAX (usado só se PG_POOL_MAX estiver ausente):
# POSTGRES_POOL_MAX=10
# search_path opcional (schema dedicado no mesmo banco; vazio = public):
# POSTGRES_SCHEMA=

# Réplica só-leitura (opcional). Leituras pesadas (dashboard, export, links públicos GET) usam este host.
# POSTGRES_READ_PORT=5432
# POSTGRES_READ_SSL=true
# POSTGRES_READ_HOST=

# GET /api/health — ping DB (público). Detalhes (filas do pool, latência) só com secret abaixo:
# Authorization: Bearer … ou header X-Health-Metrics-Token (não usar ?token= — vaza em logs/Referer)
# Gere: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# HEALTH_METRICS_SECRET=

# Uptime Kuma / status agregado (Postgres, SMTP, OpenAI, réplica se houver):
# GET /api/health/status — Authorization: Bearer … ou X-Health-Status-Token: …
# (não usar ?token= — vaza em logs/Referer)
# HTTP 200 = ok; 503 = degraded/down. Gere: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# HEALTH_STATUS_TOKEN=""

# Self-service signup — join automático por domínio de e-mail (role hr). Padrão: false.
# SIGNUP_DOMAIN_MATCH=false

# Cloudflare Turnstile (signup). Sem chaves → signup segue sem CAPTCHA (dev/DTOV).
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Limites do early access (soft caps por empresa em trial). Defaults abaixo.
# TRIAL_MAX_VACANCIES=2
# TRIAL_MAX_CANDIDATES=50
# TRIAL_MAX_USERS=3
# TRIAL_MAX_MOTIVATORS=10
# TRIAL_MAX_CLIMATE_SURVEYS=2

# ── Autenticação do gestor ───────────────────────────────────────────────────
# Conta admin inicial (bootstrap) — será criada automaticamente na primeira subida
BOOTSTRAP_ADMIN_EMAIL=admin@3035tech.com
BOOTSTRAP_ADMIN_PASSWORD=troque_esta_senha

# ── Rate limit compartilhado (opcional) ─────────────────────────────────────
# Sem REDIS_URL: limite em memória por processo (N réplicas ≈ N× limite).
# Dublin / Redis clássico (mesmo padrão Chatwoot/Evolution):
#   REDIS_URL=redis://:SENHA@redis-haproxy.redis.svc:6379/4
#   REDIS_KEY_PREFIX=team30
# Local (docker-compose / docker-compose.dev.yml):
#   REDIS_URL=redis://:team30_local@127.0.0.1:6379/0
#   REDIS_KEY_PREFIX=team30
# DTOV (test/dtov — harness já exporta):
#   REDIS_URL=redis://:dtov_redis@127.0.0.1:56379/0
#   REDIS_KEY_PREFIX=team30_dtov
REDIS_URL=redis://:team30_local@127.0.0.1:6379/0
REDIS_KEY_PREFIX=team30

# Desenvolvimento: pode omitir (usa fallback local) ou definir qualquer string.
# Produção (next start): obrigatório, ≥32 caracteres, não pode ser placeholder abaixo.
# Gere: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio

# Cookie Secure em team30_session / team30_employee_session (gestor + colaborador).
# Produção HTTPS: omitir basta (liga sozinho se NEXT_PUBLIC_APP_URL=https://…).
# Force em proxy/TLS terminado antes do app: COOKIE_SECURE=true
# COOKIE_SECURE=true

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Diretório de build alternativo (CI / validações concorrentes). Default .next
# NEXT_DIST_DIR=.next

# ── E-mail (convites + job alerts) ───────────────────────────────────────────
# SMTP de saída — necessário para «Enviar convite» na aba Vagas.
# Também usado nos **alertas de novas vagas** (/j): ao publicar página pública aberta,
# dispara e-mail aos inscritos ativos. Sem SMTP_HOST+MAIL_FROM = no-op (não falha o save).
# Cancelamento pelo inscrito: /a/unsubscribe?token=…
# 3035Tech: mail.3035tech.com — SSL na 465 (SMTP_SECURE=true) ou STARTTLS na 587 (SMTP_SECURE=false).
# Outros: Amazon SES, Gmail (app password), Mailgun, etc.
SMTP_HOST=mail.3035tech.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=team@3035tech.com
SMTP_PASS=
MAIL_FROM="30Grow <team@3035tech.com>"
# Testes/DTOV sem SMTP real: captura envios em memória (não usa nodemailer).
# Com DTOV=1 e SMTP_HOST/MAIL_FROM ausentes, o mock liga sozinho.
# Opcional: apontar SMTP_* para Mailhog (ex. host mailhog, porta 1025) no compose local.
# SMTP_MOCK=1
# Tentativas por envio SMTP real (1–3, default 3; backoff curto entre tentativas).
# MAIL_RETRY_ATTEMPTS=3

# ── Cron (lembretes de convite / prazos / retenção / digest semanal) ──────────
# POST /api/cron/invite-reminders
# POST /api/cron/vacancy-deadline-notifications
# POST /api/cron/notification-retention
# POST /api/cron/manager-weekly-digest  (?retentionDays=7&staleDays=21&email=0 para só notif)
# POST /api/cron/hour-bank-checkpoints  (diário; checkpoint do banco de horas, migration 148)
#   HOUR_BANK_CHECKPOINT_RUN_CAP=2000  pessoas por execução (1–20000); cada pessoa é reescrita a cada 7 dias,
#   então o cron cobre ~7 × cap colaboradores com banco ligado. Acima disso, aumente o cap.
# Header: Authorization: Bearer <CRON_SECRET> ou X-Cron-Secret: <CRON_SECRET>
# NEXT_PUBLIC_APP_URL deve estar definido (invite-reminders + digest e-mail).
# CRON_SECRET=

# ── Retenção (LGPD) ──────────────────────────────────────────────────────────
# Ex.: 180 = apaga assessments e candidatos órfãos após 180 dias (em lotes)
RETENTION_DAYS=180
# RETENTION_BATCH_SIZE=500
# RETENTION_MAX_BATCHES=200
# Notas internas: docs/privacidade-lgpd-interno.md

# ── Export CSV (dashboard) ───────────────────────────────────────────────────
# Teto de linhas (mais recentes). Acima disso: truncado + header X-Export-Truncated.
# EXPORT_MAX_ROWS=10000

# ── Retenção de notificações in-app (cron notification-retention) ────────────
# NOTIFICATION_RETENTION_READ_DAYS=90
# NOTIFICATION_RETENTION_UNREAD_DAYS=180

# ── Alerta retention_watch (Motivadores → Sino / Visão geral) ─────────────────
# Score mínimo (0–100) na dimensão sensível para emitir sinal/notif. Padrão 55.
# RETENTION_WATCH_MIN_SCORE=55

# ── Pulso de grupo (médias anônimas) ──────────────────────────────────────────
# Mínimo de respostas antes de mostrar agregados. Padrão 3.
# TEAM_PULSE_MIN_RESPONSES=3

# ── Pesquisa de clima (médias anônimas) ───────────────────────────────────────
# Mínimo de respostas antes de mostrar agregados (k-anon). Padrão 5.
# CLIMATE_MIN_RESPONSES=5

# ── Legado: tabela results (global por nome) ─────────────────────────────────
# false (padrão se omitido): POST /api/results não grava em `results`; use só assessments.
# true: mantém INSERT … ON CONFLICT (LOWER(name)) para scripts/dashboards antigos.
# LEGACY_RESULTS_WRITE=false

# ── HTTPS / cabeçalhos extras (produção, domínio estável) ─────────────────────
# Baseline sempre: X-Content-Type-Options, X-Frame-Options, Referrer-Policy, Permissions-Policy.
# HSTS liga automaticamente se NODE_ENV=production e NEXT_PUBLIC_APP_URL começa com https://.
# Ou force: ENABLE_HSTS=true (só com HTTPS de ponta a ponta).
# ENABLE_HSTS=true
# HSTS_MAX_AGE=31536000
# HSTS_PRELOAD=false

# Rate limit de login/APIs públicas é in-memory por processo. Com várias réplicas do app,
# o teto efetivo sobe ~N×; para limite estrito use rate-limit na borda (CDN/gateway) ou Redis.

# NEXT_PUBLIC_APP_URL é obrigatório em produção para links de convite por e-mail
# (sem fallback de Host — evita phishing via x-forwarded-host).

# CSP — report-only (medir violações) ou enforced (produção, após validar em staging).
# ENABLE_CSP=true          # aplica Content-Security-Policy (default em lib/security-csp.js)
# CSP_POLICY=              # override opcional (uma linha); default já inclui Turnstile + Cloudflare Web Analytics
# CSP_REPORT_ONLY=true     # usa a política padrão apenas em Report-Only

# ── OpenAI (rubrica, descrição de vaga, parecer /r) ───────────────────────────
# Usado por lib/vacancy-assist-ai.js e rubrica. Sem chave → assistentes retornam 503.
# Modelo barato recomendado: gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_RUBRIC_MODEL=gpt-4o-mini
# Modelo do `npm run i18n:translate` (fr-FR / de-DE). Vazio = OPENAI_RUBRIC_MODEL.
# OPENAI_TRANSLATE_MODEL=gpt-4o-mini
# Testes/DTOV: stub determinístico sem chamar a API (DTOV=1 também força mock).
# OPENAI_MOCK=1
# Fornecedor compatível com a API OpenAI (OpenRouter, Gemini). Só https. Default: https://api.openai.com/v1
# OPENAI_BASE_URL=
# Controle de custo (lib/ai-usage.js, tabela ai_usage_events — migration 144):
# AI_ENABLED=0 desliga toda a IA (telas mostram "IA indisponível"; Ajuda responde pelo Guia).
# AI_ENABLED=1
# Teto padrão de chamadas por empresa/mês (admin ajusta por empresa em Empresas → Editar). 0 bloqueia.
# AI_COMPANY_MONTHLY_CALL_LIMIT=500
# Teto opcional de todo o sistema/mês (vazio = sem teto global).
# AI_GLOBAL_MONTHLY_CALL_LIMIT=
# Modelo por funcionalidade (vazio = OPENAI_RUBRIC_MODEL). Nomes: RUBRIC_CONTEXT, RUBRIC_WEIGHTS,
# JOB_ROLE_RUBRIC, VACANCY_EXECUTIVE_NOTE, VACANCY_SHORTLIST, VACANCY_CANDIDATE_FIELDS,
# INTERVIEW_NOTES_SUMMARY, VACANCY_DESCRIPTION, PEOPLE_INTERPRET, HELP_ASSISTANT.
# AI_MODEL_HELP_ASSISTANT=gpt-4.1-nano
# Consumo por empresa/mês: Empresas → Consumo de IA (admin).

# ── Google Indexing API (vagas públicas /j) ───────────────────────────────────
# Push URL_UPDATED / URL_DELETED ao publicar/atualizar/fechar página indexável.
# Desligado por padrão. Falha do Google NÃO bloqueia salvar a vaga.
# Requer NEXT_PUBLIC_APP_URL com a URL canônica do app.
# Detalhe: docs/job-seo-and-distribution.md
# GOOGLE_INDEXING_ENABLED=false
# JSON da service account (inline) OU caminho absoluto do arquivo .json
# GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON=
# Em testes/DTOV: mock automático (DTOV=1). Forçar mock local:
# GOOGLE_INDEXING_MOCK=1

# ── Agregadores SEO públicos (/jobs/remote, /jobs/city/{slug}) ─────────────────────
# Mínimo de vagas públicas indexáveis para publicar a página (default 3).
# Abaixo do limiar → 404 (nunca lista vazia indexável).
# PUBLIC_JOB_AGGREGATOR_MIN_COUNT=3

# ── Logo da empresa (S3 / S3-compatível) ──────────────────────────────────────
# Obrigatório em produção para upload de logo (Empresas). Sem estas vars a API
# responde 503 STORAGE_NOT_CONFIGURED e o botão Logo fica desligado.
# Checklist prod: S3_BUCKET + região + chaves + S3_PUBLIC_BASE_URL (CDN/origem).
# Arquivo fica no bucket; Postgres guarda só logo_url + logo_key (migration 039).
# Crop/compress no cliente (B-1401) antes do upload — servidor valida MIME + 512 KB.
# S3_BUCKET=
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Aliases: S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY
# URL pública do bucket/CDN — só a origem (sem pasta). Ex.:
# S3_PUBLIC_BASE_URL=https://30team.s3.us-west-2.amazonaws.com
# Pasta dentro do bucket só para logos (opcional). Keys de logo:
#   {S3_KEY_PREFIX}/companies/{companyId}/{uuid}.ext
# S3_KEY_PREFIX=image/logo
# Demais arquivos (LMS PDF, etc.) ficam em:
#   companies/{companyId}/lms/courses/{courseId}/{uuid}.pdf
# (sempre com companyId; sem S3_KEY_PREFIX). A IAM precisa permitir PutObject
# em `companies/*` (além de `image/logo/companies/*` para logos).
# Endpoint custom (MinIO / R2):
# S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true

# ── Logs estruturados (stdout JSON → Docker / CloudWatch) ───────────────────
# Nível: debug|info|warn|error ou 0|1|2|3 (default info)
# LOG_LEVEL=info
# Queries/ops acima deste limiar (ms) geram warn "Slow …"
# LOG_SLOW_MS=1000

# ── Sentry (erros de app — org 3035tech-9t / project 30team) ────────────────
# Sem DSN o SDK fica desligado. Use o mesmo DSN do projeto no Sentry UI.
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX
# SENTRY_DSN=   # opcional no server; se vazio, usa NEXT_PUBLIC_SENTRY_DSN
# SENTRY_ENVIRONMENT=production
# Ambiente no SDK do navegador (default: SENTRY_ENVIRONMENT / NODE_ENV)
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Source maps no build (CI): criar token em Sentry → Settings → Auth Tokens
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=3035tech-9t
# SENTRY_PROJECT=30team
# Session Replay (opcional, custo):
# NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
# NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0

# ── Scripts de ops / seeds (não lidos pelo app em runtime) ──────────────────
# npm run db:create-super-admin — usuário admin sem company_id
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME=Super Admin
# SUPER_ADMIN_LOCALE=pt-BR
# Atualiza senha/nome se o e-mail já existir:
# SUPER_ADMIN_UPDATE=1
#
# npm run db:seed — massa sintética
# SEED_COUNT=60
# SEED_ASSESSMENTS_PER_CANDIDATE=1
# SEED_EMAIL_DOMAIN=example.com
#
# Seeds de demo (*:confirm já exporta CONFIRM_DEMO_PURGE=1; apaga só o tenant demo)
# CONFIRM_DEMO_PURGE=1
# Senhas dos logins de demo (defaults documentados no README):
# DEMO_TODOS_PASSWORD=
# DEMO_BOARD_PASSWORD=
# DEMO_30PAY_PASSWORD=
#
# npm run ops:pilot-preflight — valida integrações reais (S3/SMTP exigem flags)
#   --send-email envia um e-mail real para PILOT_SMOKE_EMAIL
# PILOT_SMOKE_EMAIL=
# PILOT_PREFLIGHT_COMPANY_ID=
#
# npm run release:post-deploy-smoke — smoke HTTP pós-deploy
# PILOT_SMOKE_BASE_URL=https://team.exemplo.com
# Cookie de sessão de gestor para rotas protegidas (não commitar):
# PILOT_SMOKE_COOKIE=
#
# DTOV=1 é exportado pelo harness de testes (test/dtov); não definir em produção.
